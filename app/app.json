{
  "expo": {
    "name": "OCC Mobile",
    "slug": "occ-app",
    "scheme": "occ",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "main": "expo-router/entry",
    "android": {
      "package": "com.aguitech.occapp",
      "adaptiveIcon": {
        "backgroundColor": "#003DA5"
      }
    },
    "ios": {
      "bundleIdentifier": "com.aguitech.occapp"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "EXPO_PUBLIC_API_URL": "http://localhost:3000",
      "router": {
        "root": "./src/app"
      }
    }
  }
}
